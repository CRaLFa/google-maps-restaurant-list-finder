# ローカル開発用の環境変数。`cp .env.example .env` して値を埋める。
# .env はコミットしない (API キーが入るため)。
#
# 読み込むのは Go サーバ (cmd/server) と Python スクリプト (scripts/store.py 経由)。
# 既に export されている環境変数は上書きしないので、一時的に別の値を使いたければ
# `MAPS_MAP_ID=xxx go run ./cmd/server` のように前置きすればよい。
#
# Python 側は scripts/store.py の位置から親を辿るのでカレントディレクトリに依存しないが、
# Go 側はカレントディレクトリの .env しか見ない。リポジトリのルートから起動すること。
#
# 本番 (Cloud Run) はこのファイルを使わない。`--set-env-vars` で渡した値が正。

# --- Python スクリプトと Go サーバの両方で使う ---

# Firestore を置いている GCP プロジェクト。
GOOGLE_CLOUD_PROJECT=

# API 呼び出しのクォータの付け先。
# gcloud の ADC が別プロジェクト (仕事用等) を向いているときに、そちらへ乗せないために設定する。
GOOGLE_CLOUD_QUOTA_PROJECT=

# --- Go サーバのみ ---

# Maps JavaScript API のキー。クライアントに露出するので必ず HTTP リファラ制限をかけたものを使う。
# 空にすると地図が出ず、その旨のメッセージが地図の枠に表示される (ツリーと検索は動く)。
MAPS_API_KEY=

# AdvancedMarkerElement に必要な Map ID。
# 空にすると開発用の DEMO_MAP_ID にフォールバックする。
MAPS_MAP_ID=

# reCAPTCHA Enterprise のサイトキー。
# 空にすると報告フォームの bot 検証を飛ばす。ローカル開発時のみ空でよい。
RECAPTCHA_SITE_KEY=

# 待ち受けポート。省略時は 8080。
# PORT=8080
